{
  "name": "wishly-production-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --var APP_ORIGIN:http://localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wishly-production-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wishly-production-db --remote",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0",
    "vitest": "^5.0.5",
    "@cloudflare/vitest-plugin": "1.4.10"
  }
}
